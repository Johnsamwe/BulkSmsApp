<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BulkSms" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/brand_ink_light</item>
        <item name="colorAccent">@color/brand_amber</item>
        <item name="colorSurface">@color/brand_card</item>
        <item name="android:windowBackground">@color/brand_paper</item>
        <item name="android:textColorPrimary">@color/brand_ink</item>
        <item name="android:textColorSecondary">@color/brand_muted</item>
    </style>

    <style name="Card.Section" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/brand_line</item>
        <item name="cardBackgroundColor">@color/brand_card</item>
    </style>

    <style name="Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/brand_ink</item>
        <item name="android:textColor">@color/brand_ink</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Label.Section" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textColor">@color/brand_primary_dark</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
