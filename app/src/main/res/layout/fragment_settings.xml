<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JS.DEV · DAR ES SALAAM"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_primary_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Mipangilio"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/brand_ink" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="USALAMA" />

                <TextView
                    android:id="@+id/tvPinStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/brand_muted"
                    android:text="PIN haijawekwa" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Primary"
                    android:id="@+id/btnSecurity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔒 Mipangilio ya PIN" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="NAKALA RUDUFU (BACKUP)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/brand_muted"
                    android:text="Hifadhi templates zako na historia ya kampeni kwenye faili moja — muhimu ukibadilisha simu. PIN haihifadhiwi kwenye backup kwa usalama." />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Primary"
                    android:id="@+id/btnExportBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="⬇️ Hifadhi Nakala (Export)" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Outline"
                    android:id="@+id/btnImportBackup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⬆️ Rudisha Nakala (Import)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="TEMPLATES ZA UJUMBE" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/brand_muted"
                    android:text="Simamia templates zako za ujumbe zilizohifadhiwa" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Outline"
                    android:id="@+id/btnManageTemplates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ona / Futa Templates" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="KUHUSU" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="13sp"
                    android:textColor="@color/brand_muted"
                    android:text="Bulk SMS Sender — Toleo 3.0\nImejengwa kwa ajili ya JS.Dev, Dar es Salaam.\nInatuma SMS kupitia SIM na kifurushi cha simu yako moja kwa moja — hakuna gharama ya ziada ya huduma ya nje." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
