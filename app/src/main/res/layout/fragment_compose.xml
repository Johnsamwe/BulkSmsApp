<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/brand_paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JS.DEV · DAR ES SALAAM"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_primary_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp"
            android:text="Tuma SMS"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/brand_ink" />

        <!-- 1. Upload -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HATUA YA 1 · PAKIA NAMBA" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Primary"
                    android:id="@+id/btnPickFile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Chagua faili (.xlsx / .csv / .txt)" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Outline"
                    android:id="@+id/btnPickContacts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12.5sp"
                    android:text="📇 Agiza kutoka Anwani za Simu" />

                <TextView
                    android:id="@+id/tvFileInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12.5sp"
                    android:textColor="@color/brand_muted" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Compose -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HATUA YA 2 · ANDIKA UJUMBE" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:counterEnabled="true"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Mfano: Habari {jina}, deni lako bado halijalipwa..."
                        android:minLines="3"
                        android:gravity="top"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvCharCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="11.5sp"
                    android:textColor="@color/brand_muted"
                    android:text="Herufi: 0 (SMS 1)" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="11.5sp"
                    android:textColor="@color/brand_primary_dark"
                    android:text="Kidokezo: tumia {jina} ndani ya ujumbe — kama faili lako lina safu ya majina, kila mteja atapokea ujumbe wenye jina lake." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Button.Outline"
                        android:id="@+id/btnSaveTemplate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:textSize="12.5sp"
                        android:text="Hifadhi kama Template" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Button.Outline"
                        android:id="@+id/btnLoadTemplate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="12.5sp"
                        android:text="Fungua Template" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Send settings -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HATUA YA 3 · MPANGILIO WA KUTUMA" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="12.5sp"
                    android:textColor="@color/brand_muted"
                    android:text="Laini ya kutuma (SIM)" />

                <Spinner
                    android:id="@+id/spinnerSim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:spinnerMode="dropdown" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="8dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Muda (sekunde)"
                            android:textSize="12.5sp"
                            android:textColor="@color/brand_muted" />
                        <EditText
                            android:id="@+id/etDelay"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="2" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kundi (batch size)"
                            android:textSize="12.5sp"
                            android:textColor="@color/brand_muted" />
                        <EditText
                            android:id="@+id/etBatchSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:text="20" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Launch + controls -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HATUA YA 4 · TUMA KAMPENI" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Primary"
                    android:id="@+id/btnSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Anza Kutuma SMS Kwa Wote" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Outline"
                    android:id="@+id/btnSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="12.5sp"
                    android:text="🕒 Panga Muda wa Kutuma Baadaye" />

                <TextView
                    android:id="@+id/tvScheduleStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="@color/brand_amber"
                    android:visibility="gone"
                    tools:text="Kampeni imepangwa: 27/07/2026 18:00" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        style="@style/Button.Outline"
                        android:id="@+id/btnPauseResume"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:textSize="12.5sp"
                        android:enabled="false"
                        android:text="Simamisha" />

                    <com.google.android.material.button.MaterialButton
                        style="@style/Button.Outline"
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:textSize="12.5sp"
                        android:enabled="false"
                        android:text="Komesha" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12.5sp"
                    android:textColor="@color/brand_muted" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="4">

                    <TextView android:id="@+id/statValid" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textColor="@color/brand_primary_dark" android:text="0" />
                    <TextView android:id="@+id/statSent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textColor="@color/status_sent" android:text="0" />
                    <TextView android:id="@+id/statDelivered" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textColor="@color/status_delivered" android:text="0" />
                    <TextView android:id="@+id/statFailed" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textStyle="bold" android:textColor="@color/status_failed" android:text="0" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="4">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="10sp" android:textColor="@color/brand_muted" android:text="SAHIHI" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="10sp" android:textColor="@color/brand_muted" android:text="ZIMETUMWA" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="10sp" android:textColor="@color/brand_muted" android:text="ZIMEFIKA" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="10sp" android:textColor="@color/brand_muted" android:text="ZIMESHINDWA" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Outline"
                    android:id="@+id/btnRetryFailed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="12.5sp"
                    android:enabled="false"
                    android:text="Jaribu Tena Zilizoshindwa" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Records -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView style="@style/Label.Section" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="REKODI ZA WALENGWA" />

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="Tafuta kwa jina au namba..."
                    android:inputType="text"
                    android:paddingHorizontal="12dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="340dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/brand_paper" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Button.Outline"
                    android:id="@+id/btnExportReport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="12.5sp"
                    android:text="Pakua Ripoti (.csv)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/brand_muted"
            android:text="Imejengwa kwa ajili ya JS.Dev — Dar es Salaam" />

    </LinearLayout>
</ScrollView>
